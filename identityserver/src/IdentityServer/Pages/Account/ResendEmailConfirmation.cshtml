@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "ارسال مجدد رایانامه تائید";
}

<div class="row justify-content-center mb-2">
    <div class="col-md-8 col-md-offset-2">
        <h1>@ViewData["Title"]</h1>
        <hr />
        <h5>رایانامه خود را وارد کنید.</h5>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-4 col-md-offset-2">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control" aria-required="true" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary mt-1">ارسال مجدد</button>
        </form>
    </div>
    <div class="col-md-4">
        <p>
            <a class="nav-link" asp-page="./login">ورود به وبگاه</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
