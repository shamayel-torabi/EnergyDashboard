@page
@model LoginModel

@{
    ViewData["Title"] = "ورود به وبگاه";
}


<div class="row justify-content-center mb-2">
    <div class="col-md-8 col-md-offset-2">
        <h1>@ViewData["Title"]</h1>
        <hr />
        <h5>از حساب کاربری خود جهت ورود به وبگاه استفاده کنید.</h5>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-4 col-md-offset-2">
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="my-2">
                <div class="checkbox">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
            </div>
            <div>
                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">ورود به سایت</button>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <p>
            <a class="nav-link" id="forgot-password" asp-page="./ForgotPassword">فراموشی گذرواژه ؟</a>
        </p>
        <p>
            <a class="nav-link" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">ثبت نام کاربر جدید</a>
        </p>
        <p>
            <a class="nav-link" id="resend-confirmation" asp-page="./ResendEmailConfirmation">ارسال مجدد رایانامه تایید حساب</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
